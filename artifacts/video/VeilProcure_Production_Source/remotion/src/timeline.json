   "text": "The notes are advisory: the A.I. cannot award or move money.",
   "line": "S7-4"
  },
  {
   "file": "S8-1.wav",
   "start": 125.1,
   "end": 132.908,
   "text": "The buyer awards the top quote and funds the escrow with exactly that amount: 1.2 testnet NEAR, from their own wallet.",
   "line": "S8-1"
  },
  {
   "file": "S8-2.wav",
   "start": 135.7,
   "end": 141.732,
   "text": "The contract now holds the funds. It can only pay the awarded supplier, or return them to the buyer.",
   "line": "S8-2"
  },
  {
   "file": "S9-1.wav",
   "start": 144.3,
   "end": 147.899,
   "text": "The supplier accepts, delivers, and anchors evidence of the work.",
   "line": "S9-1"
  },
  {
   "file": "S9-2.wav",
   "start": 153.1,
   "end": 160.133,
   "text": "The buyer approves, and the contract pays the supplier: a real transaction anyone can verify on NEAR testnet.",
   "line": "S9-2"
  },
  {
   "file": "S9-3.wav",
   "start": 162.1,
   "end": 167.22,
   "text": "A release by anyone else, or a second payout, is rejected by the contract itself.",
   "line": "S9-3"
  },
  {
   "file": "S9-4.wav",
   "start": 167.5,
   "end": 170.301,
   "text": "And every step lands in a hash-chained audit trail.",
   "line": "S9-4"
  },
  {
   "file": "S10-1.wav",
   "start": 172.3,
   "end": 177.521,
   "text": "Veil Procure. Private bids. Intelligent decisions. Payments under your control.",
   "line": "S10-1"
  }
