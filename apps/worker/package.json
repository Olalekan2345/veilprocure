{
  "name": "@veilprocure/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./jobs": "./src/jobs.ts",
    "./trigger": "./src/trigger.ts"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "once": "tsx --env-file=.env src/index.ts --once",
    "attest:check": "tsx --env-file=.env src/check-attestation.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.0",
    "@veilprocure/db": "workspace:*",
    "@veilprocure/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
