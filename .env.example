# VeilProcure configuration. NO SECRETS IN THIS FILE.
# Local development: `node scripts/dev-db.mjs start && node scripts/setup-env.mjs` generates
# apps/web/.env.local and apps/worker/.env with fresh local secrets. In hosted environments,
# supply these from a secret manager. The app refuses to start with a descriptive error if
# anything required is missing or invalid.

# ---------- web (apps/web/.env.local) ----------
APP_URL=http://localhost:3000                  # public origin; must be https in production
DATABASE_URL=postgres://veil_app:...@host:5432/veilprocure   # app role (subject to RLS)
VEIL_MASTER_KEY=                               # 32 random bytes, base64 (envelope-encryption KEK)
VEIL_KEY_ID=local-1                            # label stored with each ciphertext
DOWNLOAD_TOKEN_SECRET=                         # >=32 random bytes, base64 (signed download links)
STORAGE_DIR=./.local/objects                   # encrypted object store directory
EMAIL_TRANSPORT=disabled                       # resend | dev-mailbox (never in production) | disabled
RESEND_API_KEY=                                # required when EMAIL_TRANSPORT=resend
EMAIL_FROM=                                    # verified sender, e.g. "VeilProcure <noreply@example.com>"
SUPPORT_EMAIL=                                 # optional public support address
PRIVY_APP_ID=                                  # Privy e-mail-code sign-in (public app ID, no secret needed). Dashboard: login method Email,
                                               # "Return user data in an identity token" ON, this origin in allowed domains
TRUST_PROXY_HEADERS=false                      # true only behind a proxy that overwrites X-Forwarded-For
SESSION_TTL_HOURS=168
NEAR_NETWORK=testnet                           # only testnet is supported
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEAR_CONTRACT_ID=                              # empty = on-chain actions disabled; deployed testnet contract: veilprocure-106725.testnet
NEXT_PUBLIC_VEIL_E2E_WALLET=                   # 1 only for local automated tests (E2E wallet bridge); refused in production

# ---------- worker (apps/worker/.env) ----------
WORKER_DATABASE_URL=postgres://veil_worker:...@host:5432/veilprocure  # BYPASSRLS role
# VEIL_MASTER_KEY / VEIL_KEY_ID / NEAR_RPC_URL / NEAR_CONTRACT_ID as above
NEARAI_BASE_URL=https://cloud-api.near.ai
NEARAI_API_KEY=                                # empty = AI jobs are "blocked", nothing is sent
NEARAI_MODEL=                                  # Qwen/Qwen3.8-27B (verified live 2026-10-30); accepted only if its attestation verifies
NEARAI_ACCEPTED_TCB=UpToDate,SWHardeningNeeded

# ---------- migrations ----------
MIGRATION_DATABASE_URL=postgres://veil:...@host:5432/veilprocure   # schema owner
